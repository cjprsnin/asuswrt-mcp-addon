#!/usr/bin/with-contenv bashio
# ==============================================================================
# Start asuswrt-mcp (stdio) behind mcp-proxy (SSE on :8765)
# ==============================================================================

set -e

bashio::log.info "Starting AsusWRT MCP SSE proxy on 0.0.0.0:8765"
bashio::log.info "Router host=${ASUSWRT_HOST} user=${ASUSWRT_SSH_USERNAME} mutations=${ASUSWRT_ALLOW_MUTATIONS}"

# mcp-proxy listens for SSE clients and spawns the stdio MCP server
# Adjust flags if your mcp-proxy version uses different option names.
exec /app/venv/bin/mcp-proxy \
  --host 0.0.0.0 \
  --port 8765 \
  -- \
  /app/venv/bin/python -m asuswrt_mcp.server
