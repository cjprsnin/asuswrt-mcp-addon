#!/usr/bin/env bashio
# ==============================================================================
# Take down the S6 service cleanly
# ==============================================================================
if [[ "${1}" -ne 0 ]] && [[ "${1}" -ne 256 ]]; then
  bashio::log.warning "AsusWRT MCP service exited with code ${1}"
else
  bashio::log.info "AsusWRT MCP service stopped"
fi
